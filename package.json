{
  "name": "copilot-session-viewer",
  "displayName": "Copilot Session Viewer",
  "description": "VS Code extension for browsing saved Copilot Chat session logs.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "copilotSessionViewer",
          "title": "Copilot Logs",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "copilotSessionViewer": [
        {
          "type": "webview",
          "id": "copilotSessionViewer.sessionsView",
          "name": "Sessions",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "copilotSessionViewer.refreshSessions",
        "title": "Copilot Session Viewer: Refresh Sessions"
      },
      {
        "command": "copilotSessionViewer.openSettings",
        "title": "Copilot Session Viewer: Open Settings"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "copilotSessionViewer.refreshSessions",
          "when": "view == copilotSessionViewer.sessionsView",
          "group": "navigation"
        },
        {
          "command": "copilotSessionViewer.openSettings",
          "when": "view == copilotSessionViewer.sessionsView",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Copilot Session Viewer",
      "properties": {
        "copilotSessionViewer.vscodeUserStorageRoots": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "markdownDescription": "VS Code user storage roots to scan. Each root is expected to contain `workspaceStorage` and `globalStorage`. When empty, the platform default is used: `%APPDATA%\\Code\\User` on Windows or `~/.config/Code/User` on UNIX-like systems."
        },
        "copilotSessionViewer.workspaceStorageRoots": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "markdownDescription": "Additional workspaceStorage roots to scan directly. Use this for sample data or other development inputs outside a VS Code user storage root."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "npm run compile && npm run test:typecheck && npm run test:vitest",
    "test:typecheck": "tsc -p ./tsconfig.test.json",
    "test:vitest": "vitest run",
    "test:watch": "vitest",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "prepackage:vsix": "npm run compile",
    "package:vsix": "vsce package --allow-missing-repository"
  },
  "dependencies": {
    "dompurify": "^3.4.7",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.4",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "3.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
