{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Copilot Session Viewer",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "env": {
        "COPILOT_SESSION_VIEWER_WORKSPACE_STORAGE_ROOTS": "${workspaceFolder}/resources/workspaceStorage"
      },
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "npm: compile"
    }
  ]
}
